<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-040 puis SILO-152 (doc/architecture/21-plan-silotage.md) : API du silo Patrimoine
        (interfaces de service PatrimoineProjectionService et PlacementEvolutionService, contrats
        d'entrée/sortie, modèles patrimoniaux, ports Reader/Writer). Les moteurs et les règles de pause
        des versements vivent dans `wealth-core`. Nom de module Java inchangé
        (`com.moe.myfamilybudget.domain.wealth`).

        SILO-131 (décision D1) : aucune dépendance vers un autre silo (domain-budget a été dissous par SILO-140) ; le silo
        définit ses propres types (PatrimoineTransferModel, ScenarioAmountsModel). Aucune dépendance vers
        Spring, JPA, OpenAPI, PersistenceManager ou BudgetDataModel, et aucun retour vers Trésorerie.
        Aucune dépendance de test : le module ne contient que des contrats, testés par `wealth-core`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>domain-wealth</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>wealth-api</artifactId>
    <packaging>jar</packaging>
    <name>wealth-api</name>
    <description>API du silo Patrimoine MyFamilyBudget (contrats, ports, interfaces de service ; sans Spring ni JPA)</description>


    <build>
        <plugins>
            <!--
                REL-030 : japicmp compare l'API binaire de ce module a sa derniere version publiee
                (oldVersion=RELEASE). ignoreMissingOldVersion=true : ne fait pas echouer le build s'il n'y a
                encore aucune version publiee (silo tout juste cree). breakBuildOnBinaryIncompatibleModifications
                reste a true (herite de <pluginManagement> dans le pom racine) : un changement binaire non
                retrocompatible fait echouer `mvn verify`/`mvn clean verify`. Rapport : target/japicmp/japicmp.diff
                (et .xml) apres `mvn verify`.
            -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>com.moe.myfamilybudget</groupId>
                            <artifactId>wealth-api</artifactId>
                            <version>RELEASE</version>
                        </dependency>
                    </oldVersion>
                    <parameter>
                        <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                        <!-- REL-050 : le rapport XML est necessaire a scripts/suggest-version-bump.py -->
                        <skipXmlReport>false</skipXmlReport>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <id>japicmp</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
