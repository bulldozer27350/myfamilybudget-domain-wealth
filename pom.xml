<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.moe.myfamilybudget</groupId>
    <artifactId>domain-wealth</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>domain-wealth</name>
    <description>Silo Patrimoine MyFamilyBudget (API et Core) - Dépôt autonome</description>

    <modules>
        <module>wealth-api</module>
        <module>wealth-core</module>
    </modules>

    <properties>
        <!--
            REL-010 (back/server/doc/architecture/27-backlog-automatisation-release.md) : version unique du
            dépôt (CI Friendly Versions). `revision` est la seule valeur à modifier pour faire évoluer la
            version de ce dépôt et de ses deux modules (wealth-api, wealth-core) ; le pom racine et les pom
            enfants référencent `${revision}` plutôt qu'un littéral. flatten-maven-plugin (ci-dessous, dans
            <build>/<plugins>) résout `${revision}` dans le pom publié (GitHub Packages) sans jamais modifier
            le pom.xml source (flattenMode=resolveCiFriendliesOnly, updatePomFile=false).
        -->
        <revision>0.0.2-SNAPSHOT</revision>

        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Version clé partagée via le BOM MyFamilyBudget -->
        <myfamilybudget-bom.version>1.0.0-SNAPSHOT</myfamilybudget-bom.version>

        <!-- Versions des plugins de build -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <japicmp-maven-plugin.version>0.23.1</japicmp-maven-plugin.version>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>mfb-packages</id>
            <name>GitHub Packages MyFamilyBudget (BOM)</name>
            <url>https://maven.pkg.github.com/bulldozer27350/MyFamilyBudget</url>
        </repository>
        <!--
            REL-030 (back/server/doc/architecture/27-backlog-automatisation-release.md) : depot de lecture
            necessaire a japicmp-maven-plugin (wealth-api/pom.xml, wealth-core/pom.xml) pour resoudre la derniere
            version publiee (oldVersion=RELEASE) de ce depot et comparer l'API binaire. Meme id ("github") que
            <distributionManagement> ci-dessous : le serveur deja declare dans settings.xml (CI) s'applique
            donc automatiquement en lecture aussi. Pour un build local (hors CI), ce depot necessite un
            <server> "github" dans son propre ~/.m2/settings.xml avec un token personnel (scope read:packages).
        -->
        <repository>
            <id>github</id>
            <name>GitHub Packages Patrimoine (lecture, REL-030)</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-wealth</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- BOM centralisé MyFamilyBudget -->
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>myfamilybudget-bom</artifactId>
                <version>${myfamilybudget-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Modules internes au silo Patrimoine -->
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>wealth-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moe.myfamilybudget</groupId>
                <artifactId>wealth-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp-maven-plugin.version}</version>
                    <configuration>
                        <parameter>
                            <onlyModified>true</onlyModified>
                            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                            <ignoreMissingClasses>true</ignoreMissingClasses>
                        </parameter>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- REL-010 : résout `${revision}` dans le pom publié sur GitHub Packages, sans toucher au pom.xml
             source (updatePomFile=false). Déclaré ici (plugins actifs, pas pluginManagement) pour être
             hérité et exécuté automatiquement par wealth-api et wealth-core. -->
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>false</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-wealth</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages Snapshots</name>
            <url>https://maven.pkg.github.com/bulldozer27350/myfamilybudget-domain-wealth</url>
        </snapshotRepository>
    </distributionManagement>
</project>
