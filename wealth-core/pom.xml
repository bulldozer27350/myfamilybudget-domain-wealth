<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SILO-152 (doc/architecture/21-plan-silotage.md) : cœur du silo Patrimoine (moteurs de calcul
        `DefaultPatrimoineProjectionService` et `DefaultPlacementEvolutionService`, règles de pause des
        versements `ContributionPauseRules`, implémentations des interfaces de `wealth-api`).

        SILO-215 : il porte aussi la persistance JPA autonome du silo (package `domain.wealth.core.persistence` :
        entités `wealth_category`, `wealth_placement`, historique de valorisation et `wealth_real_estate`,
        repositories Spring Data et mapper), découverte par le scan par défaut de Spring Boot (racine
        `com.moe.myfamilybudget`). Les moteurs restent sans Spring ni JPA.

        Règle : ce module ne dépend que de `wealth-api` et de `infra-jpa` (configuration JPA commune, qui apporte
        Spring Data JPA et Hibernate). Pas de `module-info` (décision D3) : visibilité tenue par le graphe Maven
        (règle C de `MavenModuleGraphTest`) et ArchUnit. Seul le composition root (server) le référence ;
        `application` ne dépend que de `wealth-api`. Les moteurs ne sont pas des @Component : leurs beans sont
        déclarés par `DomainEngineConfig`.
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>domain-wealth</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>wealth-core</artifactId>
    <packaging>jar</packaging>
    <name>wealth-core</name>
    <description>Cœur du silo Patrimoine MyFamilyBudget (moteurs de calcul purs, et persistance JPA des placements, de l'immobilier et des catégories d'actifs)</description>

    <dependencies>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>wealth-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moe.myfamilybudget</groupId>
            <artifactId>infra-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                REL-030 : japicmp compare l'API binaire de ce module a sa derniere version publiee
                (oldVersion=RELEASE). ignoreMissingOldVersion=true : ne fait pas echouer le build s'il n'y a
                encore aucune version publiee (silo tout juste cree). breakBuildOnBinaryIncompatibleModifications
                reste a true (herite de <pluginManagement> dans le pom racine) : un changement binaire non
                retrocompatible fait echouer `mvn verify`/`mvn clean verify`. Rapport : target/japicmp/japicmp.diff
                (et .xml) apres `mvn verify`.
            -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>com.moe.myfamilybudget</groupId>
                            <artifactId>wealth-core</artifactId>
                            <version>RELEASE</version>
                        </dependency>
                    </oldVersion>
                    <parameter>
                        <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                        <!-- REL-050 : le rapport XML est necessaire a scripts/suggest-version-bump.py -->
                        <skipXmlReport>false</skipXmlReport>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <id>japicmp</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
